{
    "name": "rahmanramsi/livewire-page-group",
    "description": "a simple way to group your livewire full pages",
    "keywords": [
        "rahmanramsi",
        "laravel",
        "livewire-page-group"
    ],
    "homepage": "https://github.com/rahmanramsi/livewire-page-group",
    "license": "MIT",
    "authors": [
        {
            "name": "Rahman Ramsi",
            "email": "rahmanramsi19@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "livewire/livewire": "^3.8 || ^4.1",
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.10 || ^8.1",
        "orchestra/testbench": "^8.22 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.36 || ^3.8 || ^4.0",
        "pestphp/pest-plugin-arch": "^2.7 || ^3.1 || ^4.0",
        "pestphp/pest-plugin-laravel": "^2.4 || ^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rahmanramsi\\LivewirePageGroup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rahmanramsi\\LivewirePageGroup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rahmanramsi\\LivewirePageGroup\\LivewirePageGroupServiceProvider"
            ],
            "aliases": {
                "LivewirePageGroup": "Rahmanramsi\\LivewirePageGroup\\Facades\\LivewirePageGroup"
            }
        }
    },
    "prefer-stable": true
}
